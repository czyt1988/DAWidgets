# =============================================================================
# DAWidgets — Git 忽略规则
#
# 原则：只忽略「可由源码重新生成」或「本机私有」的内容。
# 源码、.ui、.qrc、cmake/*.cmake.in、docs/、tests/、examples/ 一律保持跟踪。
# 分区：构建目录 → CMake 生成物 → 编译中间产物 → Qt 生成代码 → IDE/编辑器
#       → 版本控制/补丁残留 → 操作系统垃圾 → 本地环境与工具链 → 本地临时文件
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 构建输出目录（本地与 CI 自定义命名）
# -----------------------------------------------------------------------------
/build/
/build-*/
/build_*/
/cmake-build-*/
/out/
/install/
_deps/

# -----------------------------------------------------------------------------
# 2. CMake 配置/生成物（in-source 配置时会污染源码树）
# -----------------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
Testing/
compile_commands.json
compile_flags.txt
.cache/

# -----------------------------------------------------------------------------
# 3. 编译器 / 链接器中间产物
#    源码仓库不应提交任何可执行文件或目标文件；实际产物都在第 1 节的构建目录内，
#    这里的规则只是兜底，防止有人误在源码树内直接编译。
# -----------------------------------------------------------------------------
*.o
*.obj
*.lo
*.slo
*.a
*.la
*.lib
*.dll
*.dylib
*.so
*.so.*
*.exp
*.ilk
*.pdb
*.idb
*.iobj
*.ipdb
*.gch
*.pch
*.tlog
*.exe
*.dSYM/
*.stackdump
*.gcda
*.gcno
*.profraw

# -----------------------------------------------------------------------------
# 4. Qt 生成代码与 qmake 本地缓存
# -----------------------------------------------------------------------------
moc_*.cpp
moc_*.h
*.moc
qrc_*.cpp
ui_*.h
*.qm
.qmake.cache
.qmake.stash

# -----------------------------------------------------------------------------
# 5. IDE / 编辑器本地状态
# -----------------------------------------------------------------------------
# Qt Creator
CMakeLists.txt.user
CMakeLists.txt.user.*
*.pro.user
*.pro.user.*
*.qmlproject.user
*.qmlproject.user.*
*.autosave

# Visual Studio
.vs/
*.suo
*.ncb
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.aps
/*.sln
/*.vcxproj
/*.vcxproj.*

# CLion / IntelliJ
.idea/
*.iml

# VS Code / clangd / ccls
.vscode/
.clangd/
.ccls-cache/

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.#*

# -----------------------------------------------------------------------------
# 6. 版本控制与补丁残留
# -----------------------------------------------------------------------------
*.orig
*.rej
*.bak

# -----------------------------------------------------------------------------
# 7. 操作系统垃圾文件
# -----------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
Icon?

# -----------------------------------------------------------------------------
# 8. 本地环境与文档工具链
# -----------------------------------------------------------------------------
.qwen/
__pycache__/
*.py[cod]
.venv/
venv/
.env
site/

# -----------------------------------------------------------------------------
# 9. 本地临时输出（项目历史约定，勿提交临时验证文本）
# -----------------------------------------------------------------------------
test_*.txt